{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-hidden-evaluator-trust.schema.json",
  "title": "Stage 2 hidden evaluator trust manifest",
  "description": "A deployment-controlled Ed25519 public-key trust root. It must not be supplied by a release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_manifest_type", "trust_manifest_id", "keys"],
  "properties": {
    "schema_version": {"const": "1"},
    "trust_manifest_type": {"const": "stage2-hidden-evaluator"},
    "trust_manifest_id": {"$ref": "#/$defs/identifier"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "purpose", "public_key_b64", "status"],
      "properties": {
        "key_id": {"$ref": "#/$defs/identifier"},
        "algorithm": {"const": "Ed25519"},
        "purpose": {"const": "stage2-hidden-promotion"},
        "public_key_b64": {
          "type": "string",
          "description": "Standard padded base64 encoding of a 32-byte Ed25519 public key.",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "status": {"enum": ["active", "retired"]}
      }
    }
  }
}
