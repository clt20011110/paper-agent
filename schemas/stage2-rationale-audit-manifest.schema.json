{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-rationale-audit-manifest.schema.json",
  "title": "Stage 2 rationale audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "corpus_hash", "model_lock_hash", "evidence_rubric_hash", "fabrication_rubric_hash"],
  "properties": {
    "version": {"const": 1},
    "cases": {"type": "array", "minItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/case"}},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "model_lock_hash": {"$ref": "#/$defs/sha256"},
    "evidence_rubric_hash": {"$ref": "#/$defs/sha256"},
    "fabrication_rubric_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case": {
      "type": "array",
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"enum": ["relevant", "boundary"]},
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/sha256"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
