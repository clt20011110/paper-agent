{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/filter-decision.schema.json",
  "title": "Stage 2 adjudicator decision",
  "type": "object", "additionalProperties": false,
  "required": ["paper_id", "decision", "score", "reason_codes", "rationale", "evidence_fields"],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["relevant", "irrelevant", "needs_review"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 48}
    },
    "evidence_fields": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
