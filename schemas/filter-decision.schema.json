{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/filter-decision.schema.json",
  "title": "Stage 2 adjudicator decision",
  "type": "object", "additionalProperties": false,
  "required": ["paper_id", "decision", "reason", "subquestion_ids"],
  "properties": {"paper_id": {"type": "string", "minLength": 1}, "decision": {"enum": ["relevant", "irrelevant", "needs_review"]}, "reason": {"type": "string", "minLength": 1}, "subquestion_ids": {"type": "array", "items": {"type": "string"}}}
}
