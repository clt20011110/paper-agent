{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-hidden-real-freeze-frame.schema.json",
  "title": "Stage 2 evaluator-private HIDDEN_REAL freeze frame",
  "description": "The deterministic natural-distribution draw created before curated annotations are opened. Do not include in a public release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_hash", "sampling_policy_version", "sampling_seed", "sampling_probability", "pair_keys"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_hash": {"$ref": "#/$defs/sha256"},
    "sampling_policy_version": {"type": "string", "minLength": 1},
    "sampling_seed": {"type": "integer"},
    "sampling_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "pair_keys": {"type": "array", "minItems": 150, "maxItems": 150, "uniqueItems": true, "items": {"$ref": "#/$defs/pairKey"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pairKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "paper_id"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "paper_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
