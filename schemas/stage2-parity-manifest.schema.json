{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-parity-manifest.schema.json",
  "title": "Stage 2 model parity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pair_ids", "corpus_hash", "tokenizer_hash", "preprocess_hash", "oracle_model_lock_hash", "candidate_model_lock_hash", "oracle_threshold_artifact_hash", "candidate_threshold_artifact_hash", "dev_manifest_hash", "window_selector_hash", "oracle_low", "oracle_high", "candidate_low", "candidate_high", "low_window_pair_ids", "high_window_pair_ids", "low_window_definition", "high_window_definition"],
  "properties": {
    "version": {"const": 1},
    "pair_ids": {"type": "array", "minItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "tokenizer_hash": {"$ref": "#/$defs/sha256"},
    "preprocess_hash": {"$ref": "#/$defs/sha256"},
    "oracle_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "candidate_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "oracle_threshold_artifact_hash": {"$ref": "#/$defs/sha256"},
    "candidate_threshold_artifact_hash": {"$ref": "#/$defs/sha256"},
    "dev_manifest_hash": {"$ref": "#/$defs/sha256"},
    "window_selector_hash": {"$ref": "#/$defs/sha256"},
    "oracle_low": {"type": "number"},
    "oracle_high": {"type": "number"},
    "candidate_low": {"type": "number"},
    "candidate_high": {"type": "number"},
    "low_window_pair_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "high_window_pair_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "low_window_definition": {"type": "string", "minLength": 1},
    "high_window_definition": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1}
  }
}
