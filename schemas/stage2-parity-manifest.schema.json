{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-parity-manifest.schema.json",
  "title": "Stage 2 FP32/conversion parity manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pair_ids", "workload_hash", "selection_receipt_hash", "pair_universe_hash", "query_assignment_hash", "corpus_hash", "tokenizer_hash", "preprocess_hash", "oracle_model_lock_hash", "candidate_model_lock_hash", "oracle_calibrator_hash", "candidate_calibrator_hash", "oracle_threshold_artifact_hash", "candidate_threshold_artifact_hash", "gold_manifest_hash", "dev_manifest_hash", "dev_label_hash", "calibration_pair_ids_hash", "window_selector_hash", "low_window_pair_ids", "high_window_pair_ids"],
  "properties": {
    "version": {"const": 2},
    "pair_ids": {"type": "array", "minItems": 10000, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "workload_hash": {"$ref": "#/$defs/sha256"},
    "selection_receipt_hash": {"$ref": "#/$defs/sha256"},
    "pair_universe_hash": {"$ref": "#/$defs/sha256"},
    "query_assignment_hash": {"$ref": "#/$defs/sha256"},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "tokenizer_hash": {"$ref": "#/$defs/sha256"},
    "preprocess_hash": {"$ref": "#/$defs/sha256"},
    "oracle_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "candidate_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "oracle_calibrator_hash": {"$ref": "#/$defs/sha256"},
    "candidate_calibrator_hash": {"$ref": "#/$defs/sha256"},
    "oracle_threshold_artifact_hash": {"$ref": "#/$defs/sha256"},
    "candidate_threshold_artifact_hash": {"$ref": "#/$defs/sha256"},
    "gold_manifest_hash": {"$ref": "#/$defs/sha256"},
    "dev_manifest_hash": {"$ref": "#/$defs/sha256"},
    "dev_label_hash": {"$ref": "#/$defs/sha256"},
    "calibration_pair_ids_hash": {"$ref": "#/$defs/sha256"},
    "window_selector_hash": {"$ref": "#/$defs/sha256"},
    "low_window_pair_ids": {"type": "array", "minItems": 200, "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "high_window_pair_ids": {"type": "array", "minItems": 200, "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1}
  }
}
