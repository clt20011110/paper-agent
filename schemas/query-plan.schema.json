{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/query-plan.schema.json",
  "title": "Compiled QueryPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_hash", "status", "created_at", "research", "scope", "inclusion", "query_variants", "providers", "filter", "citation_snowball", "budgets", "execution", "approval"],
  "properties": {
    "schema_version": {"const": "1"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["draft", "approved", "superseded"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "research": {"type": "object", "additionalProperties": false, "required": ["objective", "audience", "primary_question", "subquestions"], "properties": {"objective": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}, "primary_question": {"type": "string", "minLength": 1}, "subquestions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "question"], "properties": {"id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}}}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["date_from", "date_to", "venues", "fields", "languages", "document_types", "user_seeds", "include_arxiv_candidates"], "properties": {"date_from": {"type": "string", "format": "date"}, "date_to": {"type": "string", "format": "date"}, "venues": {"type": "array", "items": {"type": "string"}}, "fields": {"type": "array", "items": {"type": "string"}}, "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "document_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "user_seeds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "include_arxiv_candidates": {"type": "boolean"}}},
    "inclusion": {"type": "object", "additionalProperties": false, "required": ["criteria", "exclusion_criteria"], "properties": {"criteria": {"type": "array", "items": {"type": "string", "minLength": 1}}, "exclusion_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "query_variants": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "subquestion_id", "alias_group", "raw_query", "synonyms"], "properties": {"id": {"type": "string", "minLength": 1}, "subquestion_id": {"type": "string", "minLength": 1}, "alias_group": {"type": "string", "minLength": 1}, "raw_query": {"type": "string", "minLength": 1}, "synonyms": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/providerSnapshot"}},
    "filter": {"type": "object", "additionalProperties": false, "required": ["profile", "config_hash", "thresholds_hash", "screening_scope_hash", "seed_selector_version", "seed_selector_config_hash", "round_state_machine_version"], "properties": {"profile": {"type": "string", "minLength": 1}, "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "thresholds_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "screening_scope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "seed_selector_version": {"type": "string", "minLength": 1}, "seed_selector_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "round_state_machine_version": {"type": "string", "minLength": 1}}},
    "citation_snowball": {"type": "object", "additionalProperties": false, "required": ["enabled", "directions", "max_depth", "max_rounds", "max_per_seed_per_source"], "properties": {"enabled": {"type": "boolean"}, "directions": {"type": "array", "uniqueItems": true, "items": {"enum": ["references", "citations"]}}, "max_depth": {"type": "integer", "minimum": 0}, "max_rounds": {"type": "integer", "minimum": 0}, "max_per_seed_per_source": {"type": "integer", "minimum": 1}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["max_requests", "max_candidates", "max_seconds", "saturation"], "properties": {"max_requests": {"type": "integer", "minimum": 1}, "max_candidates": {"type": "integer", "minimum": 1}, "max_seconds": {"type": "integer", "minimum": 1}, "saturation": {"type": "object", "additionalProperties": false, "required": ["min_unique_included_yield", "consecutive_low_yield_rounds"], "properties": {"min_unique_included_yield": {"type": "number", "minimum": 0, "maximum": 1}, "consecutive_low_yield_rounds": {"type": "integer", "minimum": 1}}}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["provider_policy", "required_roles", "required_providers", "terms_approvals"], "properties": {"provider_policy": {"const": "all_resolved"}, "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["venue_primary", "search", "citation", "library", "metadata_enricher", "metadata_verifier", "oa_resolver", "download"]}}, "required_providers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "terms_approvals": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["provider", "terms_url"], "properties": {"provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?::[a-z][a-z0-9_-]*)?$"}, "terms_url": {"type": "string", "format": "uri"}}}}}},
    "approval": {"anyOf": [{"type": "null"}, {"$ref": "plan-approval.schema.json"}]}
  },
  "$defs": {
    "providerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "distribution", "version", "entry_point", "artifact_sha256", "manifest_hash", "enabled", "required", "roles", "capabilities", "authority", "credential_environment_variables", "credential_availability", "credentials_required", "credentials_present", "rate_limit", "data_use", "terms_url", "independence_group", "upstream_families", "upstream_policies", "resolved", "resolution_reason", "mode", "query_compiler_version", "native_query_hashes"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "entry_point": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["venue_primary", "search", "citation", "library", "metadata_enricher", "metadata_verifier", "oa_resolver", "download"]}},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "authority": {"enum": ["official", "registry", "domain_authority", "scholarly_graph", "user", "oa_index", "discovery_enhancement"]},
        "credential_environment_variables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "credential_availability": {"type": "object", "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$"}, "additionalProperties": {"type": "boolean"}},
        "credentials_required": {"type": "boolean"},
        "credentials_present": {"type": "boolean"},
        "rate_limit": {"type": "object", "additionalProperties": false, "required": ["global_qps", "max_concurrency", "cache_ttl_seconds"], "properties": {"global_qps": {"type": "number", "exclusiveMinimum": 0}, "max_concurrency": {"type": "integer", "minimum": 1}, "cache_ttl_seconds": {"type": "integer", "minimum": 0}}},
        "data_use": {"enum": ["permitted", "restricted", "unknown"]},
        "terms_url": {"type": ["string", "null"], "format": "uri"},
        "independence_group": {"type": "string", "minLength": 1},
        "upstream_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "upstream_policies": {"type": "object"},
        "resolved": {"type": "boolean"},
        "resolution_reason": {"type": "string", "minLength": 1},
        "mode": {"enum": ["api", "snapshot", "bulk_snapshot", "local"]},
        "snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "query_compiler_version": {"type": "string", "minLength": 1},
        "native_query_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    }
  }
}
