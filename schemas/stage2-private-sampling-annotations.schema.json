{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-private-sampling-annotations.schema.json",
  "title": "Stage 2 private sampling annotations",
  "description": "Provisional private curation labels and difficulty strata used only to sample DEV/HIDDEN_HARD candidates. They are not authoritative gold labels and must not enter a public release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_hash", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_hash": {"$ref": "#/$defs/sha256"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "paper_id", "label", "hard_negative", "hard_positive"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "paper_id": {"type": "string", "minLength": 1},
        "label": {"type": "integer", "minimum": 0, "maximum": 3},
        "hard_negative": {"type": "boolean"},
        "hard_positive": {"type": "boolean"}
      }
    }
  }
}
