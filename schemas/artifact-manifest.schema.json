{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/artifact-manifest.schema.json",
  "title": "Immutable run artifact manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "stage", "created_at", "config_hash", "artifacts"],
  "properties": {
    "schema_version": {"const": "1"}, "run_id": {"type": "string", "minLength": 1}, "stage": {"enum": ["search", "filter", "download", "analysis", "report"]}, "created_at": {"type": "string", "format": "date-time"}, "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256", "mime_type", "size_bytes"], "properties": {"kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "mime_type": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}}}}
  }
}
