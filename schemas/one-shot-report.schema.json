{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/one-shot-report.schema.json",
  "title": "Stage 4b one-shot report draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "blocks", "unresolved_conflicts", "claim_relations"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/draftClaim"}
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/draftBlock"}
    },
    "unresolved_conflicts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "claim_relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/draftClaimRelation"}
    }
  },
  "$defs": {
    "draftClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_ref",
        "subject_id",
        "predicate_id",
        "object_or_scope_id",
        "qualifier_context",
        "research_question_id",
        "report_section",
        "claim_text",
        "claim_type",
        "supporting_evidence",
        "contradicting_evidence",
        "evidence_level",
        "confidence",
        "known_limitations",
        "status"
      ],
      "properties": {
        "claim_ref": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "predicate_id": {"type": "string", "minLength": 1},
        "object_or_scope_id": {"type": "string", "minLength": 1},
        "qualifier_context": {"type": "string", "minLength": 1},
        "research_question_id": {"type": "string", "minLength": 1},
        "report_section": {"type": "string", "minLength": 1},
        "claim_text": {"type": "string", "minLength": 1},
        "claim_type": {
          "type": "string",
          "enum": ["finding", "trend", "comparison", "gap", "recommendation", "corpus_stat"]
        },
        "supporting_evidence": {
          "type": "array",
          "items": {"$ref": "claim-evidence.schema.json#/$defs/evidenceRef"}
        },
        "contradicting_evidence": {
          "type": "array",
          "items": {"$ref": "claim-evidence.schema.json#/$defs/evidenceRef"}
        },
        "evidence_level": {
          "type": "string",
          "enum": ["full_text_direct", "full_text_inferred", "abstract_direct", "metadata_only", "corpus_stat"]
        },
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "known_limitations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "status": {"type": "string", "enum": ["supported", "mixed", "insufficient"]}
      }
    },
    "draftBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "block_kind",
        "section_id",
        "text",
        "claim_refs",
        "citation_paper_ids"
      ],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "block_kind": {
          "type": "string",
          "enum": ["prose", "list_item", "table_cell", "caption"]
        },
        "section_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "citation_paper_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "draftClaimRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_claim_id", "current_claim_ref", "relation_type", "reason"],
      "properties": {
        "previous_claim_id": {"type": "string", "format": "uuid"},
        "current_claim_ref": {"type": "string", "minLength": 1},
        "relation_type": {
          "type": "string",
          "enum": ["same", "refined", "split", "merged", "superseded", "retired"]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
