{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/report-document.schema.json",
  "title": "ReportDocument AST",
  "type": "object", "additionalProperties": false,
  "required": ["report_run_id", "blocks"],
  "properties": {
    "report_run_id": {"type": "string", "minLength": 1},
    "blocks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["block_id", "block_kind", "section_id", "text", "claim_ids", "citation_paper_ids"], "properties": {"block_id": {"type": "string", "minLength": 1}, "block_kind": {"type": "string", "enum": ["prose", "list_item", "table_cell", "caption"]}, "section_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}, "citation_paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
  }
}
