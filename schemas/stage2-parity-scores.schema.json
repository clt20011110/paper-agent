{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-parity-scores.schema.json",
  "title": "Stage 2 FP32/conversion parity scores v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "manifest_hash", "workload_hash", "oracle_model_lock_hash", "candidate_model_lock_hash", "score_count", "failure_count", "scores"],
  "properties": {
    "schema_version": {"const": "2"},
    "kind": {"const": "stage2_parity_scores"},
    "manifest_hash": {"$ref": "#/$defs/sha256"},
    "workload_hash": {"$ref": "#/$defs/sha256"},
    "oracle_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "candidate_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "score_count": {"const": 10000},
    "failure_count": {"const": 0},
    "scores": {
      "type": "array", "minItems": 10000, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "oracle_score", "candidate_score"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "oracle_score": {"type": "number"},
          "candidate_score": {"type": "number"}
        }
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
