{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-parity-scores.schema.json",
  "title": "Stage 2 model parity raw scores",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "scores"],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "stage2_parity_scores"},
    "scores": {
      "type": "array",
      "minItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "manifest_hash", "oracle_score", "candidate_score"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "oracle_score": {"type": "number"},
          "candidate_score": {"type": "number"}
        }
      }
    }
  }
}
