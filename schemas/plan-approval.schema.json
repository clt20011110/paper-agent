{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/plan-approval.schema.json",
  "title": "Detached plan approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["approved_hash", "approved_by", "approved_at", "approval_method"],
  "properties": {
    "approved_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "approval_method": {"type": "string", "enum": ["cli_hash", "interactive_confirmation"]}
  }
}
