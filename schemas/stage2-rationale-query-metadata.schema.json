{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-rationale-query-metadata.schema.json",
  "title": "Frozen Stage 2 rationale query metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "candidate_id", "candidate_bundle_sha256", "benchmark_papers_sha256", "primary_languages", "scores", "assignments"],
  "properties": {
    "schema_version": {"const": "3"},
    "kind": {"const": "stage2_rationale_query_metadata"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "benchmark_papers_sha256": {"$ref": "#/$defs/sha256"},
    "primary_languages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scores": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/score"}},
    "assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "source_paper_id", "language", "topic", "query_version", "query", "stratum", "reranker_raw_score", "reranker_probability"],
      "properties": {
        "pair_id": {"$ref": "#/$defs/sha256"},
        "source_paper_id": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "query_version": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "stratum": {"enum": ["relevant", "boundary", "irrelevant"]},
        "reranker_raw_score": {"type": "number"},
        "reranker_probability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "assignment": {
      "allOf": [
        {"$ref": "#/$defs/score"},
        {"properties": {"stratum": {"enum": ["relevant", "boundary"]}}}
      ]
    }
  }
}
