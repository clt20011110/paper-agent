{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-gold-sampling-provenance.schema.json",
  "title": "Stage 2 gold sampling provenance",
  "description": "Private binding from a frozen corpus snapshot and private sampling annotations to a public gold manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_hash", "corpus_hash", "sampling_policy_version", "sampling_seed", "sampling_annotations_hash", "gold_manifest_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_hash": {"$ref": "#/$defs/sha256"},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "sampling_policy_version": {"type": "string", "minLength": 1},
    "sampling_seed": {"type": "integer"},
    "sampling_annotations_hash": {"$ref": "#/$defs/sha256"},
    "gold_manifest_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
