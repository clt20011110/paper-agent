{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-promotion-submission.schema.json",
  "title": "Stage 2 private promotion submission",
  "description": "Private evaluator input. Raw prediction records must not be included in a release bundle, package fixture, or template.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "runs"],
  "properties": {
    "schema_version": {"const": "1"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 300,
        "maxItems": 300,
        "items": {"$ref": "#/$defs/prediction"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pairId": {
      "type": "string",
      "pattern": "^pair-[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "candidate_id",
        "decision",
        "raw_score",
        "probability",
        "path",
        "calibrator_hash",
        "threshold_hash",
        "model_lock_hash",
        "manifest_hash",
        "stage2_config_hash",
        "inference_artifact_hash",
        "review_reason"
      ],
      "properties": {
        "pair_id": {"$ref": "#/$defs/pairId"},
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "decision": {"enum": ["relevant", "irrelevant", "needs_review"]},
        "raw_score": {"type": ["number", "null"]},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "path": {"enum": ["reranker", "qwen"]},
        "calibrator_hash": {"$ref": "#/$defs/sha256"},
        "threshold_hash": {"$ref": "#/$defs/sha256"},
        "model_lock_hash": {"$ref": "#/$defs/sha256"},
        "manifest_hash": {"$ref": "#/$defs/sha256"},
        "stage2_config_hash": {"$ref": "#/$defs/sha256"},
        "inference_artifact_hash": {"$ref": "#/$defs/sha256"},
        "review_reason": {
          "type": ["string", "null"],
          "enum": ["uncertain", "schema_error", "timeout", "service_error", "model_conflict", null]
        }
      }
    }
  }
}
