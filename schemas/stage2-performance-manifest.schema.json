{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-performance-manifest.schema.json",
  "title": "Stage 2 performance routing manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "corpus_hash", "stage2_config_hash", "model_lock_hashes", "threshold_artifact_hashes", "output_token_limit", "input_token_estimator", "cases", "normal_qwen_ids", "stress_qwen_ids", "pipeline_components"],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "benchmark"},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "stage2_config_hash": {"$ref": "#/$defs/sha256"},
    "model_lock_hashes": {"$ref": "#/$defs/hashArray"},
    "threshold_artifact_hashes": {"$ref": "#/$defs/hashArray"},
    "output_token_limit": {"type": "integer", "minimum": 1},
    "input_token_estimator": {
      "description": "Versioned prompt-size proxy identity; values are not exact tokenizer counts.",
      "const": "omlx-chat-content-chars-proxy-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1000,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"},
      "contains": {"type": "object", "properties": {"abstract_missing": {"const": true}}, "required": ["abstract_missing"]},
      "minContains": 100,
      "maxContains": 100
    },
    "normal_qwen_ids": {"type": "array", "minItems": 150, "maxItems": 150, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "stress_qwen_ids": {"type": "array", "minItems": 300, "maxItems": 300, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "pipeline_components": {"const": ["rules", "reranker", "qwen", "schema_validation", "sqlite_commit"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "hashArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "input_tokens", "abstract_missing"],
      "properties": {
        "pair_id": {"$ref": "#/$defs/id"},
        "input_tokens": {
          "description": "Prompt-size proxy produced by input_token_estimator, not an exact tokenizer count.",
          "type": "integer",
          "minimum": 1
        },
        "abstract_missing": {"type": "boolean"}
      }
    }
  }
}
