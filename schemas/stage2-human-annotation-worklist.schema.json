{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-human-annotation-worklist.schema.json",
  "title": "Stage 2 evaluator-private human annotation worklist",
  "description": "Editable blind annotation or adjudication worklist. It contains private paper text and human labels and must remain in evaluator custody.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "gold_manifest_hash",
    "rubric_version",
    "rubric_hash",
    "role",
    "participant_id",
    "annotation_input_hash",
    "rubric",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "stage2_human_annotation_worklist"},
    "gold_manifest_hash": {"$ref": "#/$defs/sha256"},
    "rubric_version": {"const": 1},
    "rubric_hash": {"$ref": "#/$defs/sha256"},
    "role": {"enum": ["annotator", "adjudicator"]},
    "participant_id": {"type": "string", "minLength": 1},
    "annotation_input_hash": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "rubric": {"$ref": "#/$defs/rubric"},
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "annotator"}}},
      "then": {"properties": {"annotation_input_hash": {"type": "null"}}}
    },
    {
      "if": {"properties": {"role": {"const": "adjudicator"}}},
      "then": {"properties": {"annotation_input_hash": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pairId": {
      "type": "string",
      "pattern": "^pair-[a-f0-9]{64}$"
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "positive_labels", "labels"],
      "properties": {
        "version": {"const": 1},
        "positive_labels": {"const": [2, 3]},
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1", "2", "3"],
          "properties": {
            "0": {"type": "string", "minLength": 1},
            "1": {"type": "string", "minLength": 1},
            "2": {"type": "string", "minLength": 1},
            "3": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "topic", "title", "abstract", "language", "label"],
      "properties": {
        "pair_id": {"$ref": "#/$defs/pairId"},
        "topic": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "abstract": {"type": ["string", "null"]},
        "language": {"type": "string", "minLength": 1},
        "label": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 3}
          ]
        }
      }
    }
  }
}
