{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/report-repair.schema.json",
  "title": "Typed report repair patch set",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_artifact_hash", "patches"],
  "properties": {
    "base_artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "patches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "operation", "block_id", "precondition_hash", "value"],
            "properties": {
              "target": {"type": "string", "const": "REPORT_DOCUMENT"},
              "operation": {"type": "string", "const": "replace_block"},
              "block_id": {"type": "string", "minLength": 1},
              "precondition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "value": {"$ref": "report-document.schema.json#/properties/blocks/items"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "operation", "claim_id", "precondition_hash", "value"],
            "properties": {
              "target": {"type": "string", "const": "CLAIMS_EVIDENCE"},
              "operation": {"type": "string", "const": "replace_claim"},
              "claim_id": {"type": "string", "format": "uuid"},
              "precondition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "value": {"$ref": "claim-evidence.schema.json"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "operation", "paper_id", "precondition_hash", "value"],
            "properties": {
              "target": {"type": "string", "const": "COVERAGE"},
              "operation": {"type": "string", "const": "replace_paper"},
              "paper_id": {"type": "string", "minLength": 1},
              "precondition_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "paper_id",
                  "evidence_claim_ids",
                  "consumed_node_ids",
                  "disposition",
                  "reason"
                ],
                "properties": {
                  "paper_id": {"type": "string", "minLength": 1},
                  "evidence_claim_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {"type": "string", "format": "uuid"}
                  },
                  "consumed_node_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "disposition": {"type": "string", "enum": ["evidence", "resource_or_background_table", "background_only", "uncovered"]},
                  "reason": {"type": ["string", "null"]}
                }
              }
            }
          }
        ]
      }
    }
  }
}
