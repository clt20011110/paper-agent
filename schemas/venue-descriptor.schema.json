{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/venue-descriptor.schema.json",
  "title": "Versioned venue descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "venue_id", "name", "venue_type", "primary_provider", "provider_params"],
  "properties": {
    "schema_version": {"const": "1"},
    "venue_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "venue_type": {"type": "string", "enum": ["conference", "journal", "repository"]},
    "primary_provider": {"type": "string", "minLength": 1},
    "provider_params": {"type": "object", "additionalProperties": true},
    "official_url": {"type": "string", "format": "uri"},
    "proceedings_url": {"type": "string", "format": "uri"},
    "date_range": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}
    }
  }
}
