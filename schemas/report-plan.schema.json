{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/report-plan.schema.json",
  "title": "Frozen ReportPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_hash", "status", "created_at", "objective", "audience", "primary_question", "subquestions", "synthesis_question", "scope", "query_plan_hash", "corpus_snapshot_hash", "search_audit_pack_hash", "stage4b_config_hash", "stage4b_audit_config_hash", "aggregation", "sections", "classification_axes", "cohort_rules", "paper_memberships", "artifacts", "budget", "schema_hash", "prompt_hashes", "approval"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"}, "plan_id": {"type": "string", "minLength": 1}, "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"type": "string", "enum": ["draft", "approved", "superseded"]}, "created_at": {"type": "string", "format": "date-time"},
    "objective": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}, "primary_question": {"type": "string", "minLength": 1}, "subquestions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "question"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}}}}, "synthesis_question": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["date_from", "date_to", "venues", "document_types", "languages", "inclusion_criteria", "exclusion_criteria"], "properties": {"date_from": {"type": "string", "format": "date"}, "date_to": {"type": "string", "format": "date"}, "venues": {"type": "array", "items": {"type": "string"}}, "document_types": {"type": "array", "items": {"type": "string"}}, "languages": {"type": "array", "items": {"type": "string"}}, "inclusion_criteria": {"type": "array", "items": {"type": "string"}}, "exclusion_criteria": {"type": "array", "items": {"type": "string"}}}},
    "query_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "corpus_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "search_audit_pack_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "workflow_handoff": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["handoff_id", "workflow_binding_hash", "bundle_hash"], "properties": {"handoff_id": {"type": "string", "minLength": 1}, "workflow_binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}]}, "stage4b_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "stage4b_audit_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "aggregation": {"type": "object", "additionalProperties": false, "required": ["max_chunk_input_tokens", "reduce_output_tokens"], "properties": {"max_chunk_input_tokens": {"type": "integer", "minimum": 1}, "reduce_output_tokens": {"type": "integer", "minimum": 1}}},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "subquestion_ids", "target_words", "evidence_requirements", "allowed_evidence_levels"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "subquestion_ids": {"type": "array", "items": {"type": "string"}}, "target_words": {"type": "integer", "minimum": 1}, "evidence_requirements": {"type": "array", "items": {"type": "string"}}, "allowed_evidence_levels": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["full_text_direct", "full_text_inferred", "abstract_direct", "metadata_only", "corpus_stat"]}}}}},
    "classification_axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["subquestion", "theme", "method_family", "task", "dataset", "benchmark", "time", "venue", "publication_status", "evidence_type", "study_setting"]}},
    "cohort_rules": {"type": "object", "additionalProperties": false, "required": ["recent_cutoff", "foundational_rule", "peer_review_rule", "study_setting_rule"], "properties": {"recent_cutoff": {"type": "string", "format": "date"}, "foundational_rule": {"type": "string", "minLength": 1}, "peer_review_rule": {"type": "string", "minLength": 1}, "study_setting_rule": {"type": "string", "minLength": 1}}},
    "paper_memberships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["paper_id", "section_ids", "primary_section_id", "coverage_disposition", "coverage_reason", "resource_table_ids"], "properties": {"paper_id": {"type": "string"}, "section_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "primary_section_id": {"type": "string"}, "coverage_disposition": {"type": "string", "enum": ["evidence", "resource_or_background_table", "background_only"]}, "coverage_reason": {"type": ["string", "null"]}, "resource_table_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["comparison_tables", "trend_statistics", "resource_tables", "appendices"], "properties": {"comparison_tables": {"type": "array", "items": {"type": "string"}}, "trend_statistics": {"type": "array", "items": {"type": "string"}}, "resource_tables": {"type": "array", "items": {"type": "string"}}, "appendices": {"type": "array", "items": {"type": "string"}}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_sol_calls", "max_input_tokens", "max_retries", "audit_calls", "repair_calls"], "properties": {"max_sol_calls": {"type": "integer", "minimum": 1}, "max_input_tokens": {"type": "integer", "minimum": 1}, "max_retries": {"type": "integer", "minimum": 0}, "audit_calls": {"type": "integer", "const": 2}, "repair_calls": {"type": "integer", "const": 1}}},
    "schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "prompt_hashes": {"type": "object", "additionalProperties": false, "required": ["planning_assist", "section_reduce", "cross_section_reduce", "final_reduce", "quality_audit", "repair"], "properties": {"planning_assist": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "section_reduce": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "cross_section_reduce": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "final_reduce": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "quality_audit": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "repair": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "approval": {"anyOf": [{"type": "null"}, {"$ref": "plan-approval.schema.json"}]}
  }
}
