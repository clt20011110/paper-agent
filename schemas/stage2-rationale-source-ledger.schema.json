{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-rationale-source-ledger.schema.json",
  "title": "Bound Stage 2 Qwen rationale source ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "candidate", "benchmark_papers_sha256", "corpus_hash", "query_metadata_sha256", "records"],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "stage2_qwen_adjudication_ledger"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "benchmark_papers_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "query_metadata_sha256": {"$ref": "#/$defs/sha256"},
    "records": {"type": "array", "minItems": 100, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "bundle_sha256", "release_hash", "adjudicator_model_id", "adjudicator_model_lock_hash", "prompt_version", "response_schema"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "release_hash": {"$ref": "#/$defs/sha256"},
        "adjudicator_model_id": {"type": "string", "minLength": 1},
        "adjudicator_model_lock_hash": {"$ref": "#/$defs/sha256"},
        "prompt_version": {"type": "string", "minLength": 1},
        "response_schema": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "decision", "score", "rationale", "evidence_fields"],
      "properties": {
        "paper_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["relevant", "irrelevant", "needs_review"]},
        "score": {"type": "number"},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["title", "abstract", "keywords"]}}
      }
    }
  }
}
