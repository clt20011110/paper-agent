{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/evidence-unit.schema.json",
  "title": "Atomic paper evidence unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim", "direction", "task_id", "dataset_id", "metric_id", "metric_definition_hash", "unit", "optimization_direction", "value", "protocol_id", "protocol_hash", "baseline_id", "conditions", "locator", "comparison_eligibility", "missing_fields"],
  "properties": {
    "claim": {"type": "string", "minLength": 1},
    "direction": {"enum": ["support", "contradict", "neutral"]},
    "task_id": {"type": ["string", "null"]},
    "dataset_id": {"type": ["string", "null"]},
    "dataset_version": {"type": ["string", "null"]},
    "split_id": {"type": ["string", "null"]},
    "metric_id": {"type": ["string", "null"]},
    "metric_definition_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "unit": {"type": ["string", "null"]},
    "optimization_direction": {"enum": ["maximize", "minimize", "not_applicable"]},
    "value": {"type": ["number", "string", "null"]},
    "uncertainty": {"type": ["string", "null"]},
    "statistical_method": {"type": ["string", "null"]},
    "protocol_id": {"type": ["string", "null"]},
    "protocol_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "sample_size": {"type": ["integer", "null"], "minimum": 0},
    "baseline_id": {"type": ["string", "null"]},
    "baseline_version": {"type": ["string", "null"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["page", "section", "input_field"]}, "value": {"type": "string", "minLength": 1}}},
    "normalization_method": {"type": ["string", "null"]},
    "normalizer_version": {"type": ["string", "null"]},
    "source_value": {"type": ["string", "number", "null"]},
    "comparison_eligibility": {"enum": ["comparable", "not_comparable"]},
    "missing_fields": {"type": "array", "items": {"type": "string"}}
  }
}
