{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-private-corpus-snapshot.schema.json",
  "title": "Stage 2 private corpus snapshot",
  "description": "Private crawler text and annotation-source sampling input. Do not include in a public release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sampling_policy_version", "sampling_seed", "corpus_hash", "papers"],
  "properties": {
    "schema_version": {"const": 1},
    "sampling_policy_version": {"type": "string", "minLength": 1},
    "sampling_seed": {"type": "integer"},
    "corpus_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "papers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/paper"}}
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "paper_id", "title", "abstract", "metadata", "source", "language", "paper_family", "sampling_weight", "sampling_probability", "abstract_incomplete", "natural_crawler_population", "cross_language_match"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "paper_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "abstract": {"type": ["string", "null"]},
        "metadata": {"type": "object"},
        "source": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "paper_family": {"type": "string", "minLength": 1},
        "sampling_weight": {"type": "number", "exclusiveMinimum": 0},
        "sampling_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "abstract_incomplete": {"type": "boolean"},
        "natural_crawler_population": {"type": "boolean"},
        "cross_language_match": {"type": "boolean"}
      }
    }
  }
}
