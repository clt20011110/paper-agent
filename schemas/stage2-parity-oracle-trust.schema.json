{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-parity-oracle-trust.schema.json",
  "title": "Stage 2 parity oracle trust manifest",
  "description": "A deployment-controlled trust root for the official FP32 parity oracle and its released calibration. It must not be supplied by a candidate release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trust_manifest_type",
    "trust_manifest_id",
    "official_oracle_model_lock_hash",
    "oracle_calibrator_hash",
    "oracle_threshold_artifact_hash",
    "tokenizer_hash",
    "preprocess_hash"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "trust_manifest_type": {"const": "stage2-parity-oracle"},
    "trust_manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "official_oracle_model_lock_hash": {"$ref": "#/$defs/sha256"},
    "oracle_calibrator_hash": {"$ref": "#/$defs/sha256"},
    "oracle_threshold_artifact_hash": {"$ref": "#/$defs/sha256"},
    "tokenizer_hash": {"$ref": "#/$defs/sha256"},
    "preprocess_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
