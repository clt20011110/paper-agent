{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/cross-section-synthesis.schema.json",
  "title": "Stage 4b cross-section reduce output",
  "type": "object", "additionalProperties": false,
  "required": ["section_ids", "draft", "claims", "citation_paper_ids", "unresolved_conflicts"],
  "properties": {"section_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "draft": {"type": "string"}, "claims": {"type": "array", "items": {"$ref": "claim-evidence.schema.json"}}, "citation_paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "unresolved_conflicts": {"type": "array", "items": {"type": "string"}}}
}
