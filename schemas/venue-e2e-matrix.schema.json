{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.local/schemas/venue-e2e-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage_contract", "venues"],
  "properties": {
    "schema_version": {"const": "paper-agent.venue-e2e-matrix.v1"},
    "stage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage1", "stage2", "stage3", "stage4", "stage4b"],
      "properties": {
        "stage1": {"type": "object"},
        "stage2": {"type": "object"},
        "stage3": {"type": "object"},
        "stage4": {"type": "object"},
        "stage4b": {"type": "object"}
      }
    },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "year", "topic", "descriptor", "official_identity_url", "paper"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "year": {"type": "integer", "minimum": 2024},
          "topic": {"type": "string", "minLength": 1},
          "descriptor": {"type": "string", "pattern": "^venues/[a-z0-9_]+\\.yaml$"},
          "official_identity_url": {"type": "string", "format": "uri"},
          "paper": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "authors", "metadata_source_url", "landing_url", "pdf_url", "access_basis"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "authors": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
              "metadata_source_url": {"type": "string", "format": "uri"},
              "landing_url": {"type": "string", "format": "uri"},
              "pdf_url": {"type": "string", "format": "uri"},
              "access_basis": {
                "enum": ["official_open_access", "official_pdf_url", "legal_author_copy"]
              }
            }
          }
        }
      }
    }
  }
}
