{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/authorization-grant.schema.json",
  "title": "Immutable authorization grant",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "grant_id", "content_hash", "status", "kind", "actions", "purpose", "mode", "allow_unattended", "scope", "max_papers", "expires_at", "skill_digest", "dependency_digest", "lineage_hash", "approval"],
  "properties": {
    "schema_version": {"const": "2"}, "grant_id": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["draft", "approved", "revoked", "expired"]}, "kind": {"enum": ["download", "browser_data_sharing", "remote_model_processing"]},
    "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["download", "store", "extract", "browser_data_sharing", "remote_model_processing"]}}, "purpose": {"type": "string", "minLength": 1}, "mode": {"enum": ["attended", "unattended"]}, "allow_unattended": {"type": "boolean"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["paper_ids", "artifact_hashes", "collection_ids", "collection_snapshot_hash", "selection_snapshot_hash", "domains", "provider", "model", "data_categories"], "properties": {"paper_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "artifact_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "collection_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "collection_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "selection_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "data_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["metadata", "abstract", "full_text", "normalized_text", "analysis", "evidence", "claim_ledger", "report_draft"]}}}},
    "max_papers": {"type": "integer", "minimum": 1}, "expires_at": {"type": "string", "format": "date-time"}, "skill_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "dependency_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "lineage_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "approval": {"anyOf": [{"type": "null"}, {"$ref": "plan-approval.schema.json"}]}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "unattended"}}, "required": ["mode"]}, "then": {"properties": {"allow_unattended": {"const": true}}}},
    {"if": {"properties": {"mode": {"const": "attended"}}, "required": ["mode"]}, "then": {"properties": {"allow_unattended": {"const": false}}}}
  ]
}
