{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-curation-decisions.schema.json",
  "title": "Stage 2 evaluator-private curation decisions",
  "description": "Private provisional sampling strata. These are not authoritative gold labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worklist_hash", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "worklist_hash": {"$ref": "#/$defs/sha256"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "paper_id", "provisional_label", "hard_negative", "hard_positive", "source"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "paper_id": {"type": "string", "minLength": 1},
        "provisional_label": {"type": "integer", "minimum": 0, "maximum": 3},
        "hard_negative": {"type": "boolean"},
        "hard_positive": {"type": "boolean"},
        "source": {"enum": ["human_provisional", "model_provisional", "human_reviewed_model_suggestion"]}
      }
    }
  }
}
