{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/paper-analysis.schema.json",
  "title": "Stage 4 paper analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["paper_id", "artifact_hash", "model", "model_revision", "prompt_hash", "schema_hash", "created_at", "summary", "methods", "datasets", "results", "limitations", "resources", "topic_relevance", "labels", "evidence_units"],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"const": "gpt-5.6-luna"},
    "model_revision": {"type": "string", "minLength": 1},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "methods": {"type": "array", "items": {"type": "string"}},
    "datasets": {"type": "array", "items": {"type": "string"}},
    "results": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "resources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "url"], "properties": {"kind": {"enum": ["code", "data", "model", "other"]}, "url": {"type": "string", "format": "uri"}}}},
    "topic_relevance": {"type": "string", "minLength": 1},
    "labels": {"type": "object", "additionalProperties": false, "required": ["subquestion", "theme", "method_family", "task", "dataset", "benchmark", "evidence_type", "publication_status", "study_setting"], "properties": {"subquestion": {"type": "array", "items": {"type": "string"}}, "theme": {"type": "array", "items": {"type": "string"}}, "method_family": {"type": "array", "items": {"type": "string"}}, "task": {"type": "array", "items": {"type": "string"}}, "dataset": {"type": "array", "items": {"type": "string"}}, "benchmark": {"type": "array", "items": {"type": "string"}}, "evidence_type": {"type": "array", "items": {"type": "string"}}, "publication_status": {"enum": ["peer_reviewed", "workshop", "preprint", "unknown"]}, "study_setting": {"enum": ["real", "simulation", "theory", "other"]}}},
    "evidence_units": {"type": "array", "items": {"$ref": "evidence-unit.schema.json"}}
  }
}
