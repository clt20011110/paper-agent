{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-curation-worklist.schema.json",
  "title": "Stage 2 evaluator-private curation worklist",
  "description": "Private curation candidates after HIDDEN_REAL pairs and their paper families are excluded. Do not include in a release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_hash", "hidden_real_freeze_frame_hash", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_hash": {"$ref": "#/$defs/sha256"},
    "hidden_real_freeze_frame_hash": {"$ref": "#/$defs/sha256"},
    "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "paper_id", "title", "abstract", "source", "language", "paper_family", "abstract_incomplete", "cross_language_match"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "paper_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "abstract": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "paper_family": {"type": "string", "minLength": 1},
        "abstract_incomplete": {"type": "boolean"},
        "cross_language_match": {"type": "boolean"}
      }
    }
  }
}
