{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-gold-manifest.schema.json",
  "title": "Stage 2 public gold manifest",
  "description": "Public sampling metadata only. Paper text, annotations, labels, and private sampling strata are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "corpus_hash", "main_languages", "pairs"],
  "properties": {
    "version": {"const": 1},
    "corpus_hash": {"$ref": "#/$defs/sha256"},
    "main_languages": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pairs": {
      "type": "array",
      "items": {"$ref": "#/$defs/pair"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "paper_id", "topic", "language", "source", "sampling_probability", "paper_family", "corpus_hash", "split", "abstract_incomplete", "sampled_from_natural_distribution", "cross_language_match"],
      "allOf": [
        {
          "if": {"properties": {"split": {"const": "hidden_real"}}, "required": ["split"]},
          "then": {
            "properties": {
              "sampling_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "sampled_from_natural_distribution": {"const": true}
            }
          },
          "else": {
            "properties": {
              "sampling_probability": {"const": null},
              "sampled_from_natural_distribution": {"const": false}
            }
          }
        }
      ],
      "properties": {
        "pair_id": {"type": "string", "pattern": "^pair-[a-f0-9]{64}$"},
        "paper_id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "sampling_probability": {"type": ["number", "null"]},
        "paper_family": {"type": "string", "minLength": 1},
        "corpus_hash": {"$ref": "#/$defs/sha256"},
        "split": {"enum": ["dev", "hidden_hard", "hidden_real"]},
        "abstract_incomplete": {"type": "boolean"},
        "sampled_from_natural_distribution": {"type": "boolean"},
        "cross_language_match": {"type": "boolean"}
      }
    }
  }
}
