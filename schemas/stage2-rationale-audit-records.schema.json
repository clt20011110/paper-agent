{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-rationale-audit-records.schema.json",
  "title": "Stage 2 rationale audit raw records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "records"],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "stage2_rationale_audit_records"},
    "records": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "manifest_hash", "evidence_supported", "severe_fabrication"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evidence_supported": {"type": "boolean"},
          "severe_fabrication": {"type": "boolean"}
        }
      }
    }
  }
}
