{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/acceptance-manifest.schema.json",
  "title": "Built-in venue acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "venue_id", "primary_provider", "test_window", "fixture_path", "fixture_sha256", "expected_stable_ids", "transport_fixture_routes", "transport_expected_stable_ids", "required_fields", "required_capabilities", "fallbacks"],
  "properties": {
    "schema_version": {"const": "2"},
    "venue_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "primary_provider": {"type": "string", "minLength": 1},
    "test_window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}
    },
    "fixture_path": {"type": "string", "pattern": "^tests/fixtures/providers/[a-z0-9._-]+\\.json$"},
    "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transport_fixture_routes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "content_type", "url_contains"],
        "properties": {
          "path": {"type": "string", "pattern": "^tests/fixtures/providers/[a-z0-9._-]+\\.(?:html|json|xml)$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_type": {"type": "string", "minLength": 1},
          "url_contains": {"type": "string", "minLength": 1}
        }
      }
    },
    "transport_expected_stable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stable_id", "metadata", "abstract", "date_filter"]}},
    "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stable_id", "metadata", "abstract", "date_filter", "references", "citations", "oa_locations", "full_text", "supplement", "bulk_snapshot"]}},
    "fallbacks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["provider", "role"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "role": {"enum": ["venue_primary", "search", "citation", "library", "metadata_enricher", "metadata_verifier", "oa_resolver", "download"]}
        }
      }
    },
    "journal": {
      "type": "object", "additionalProperties": false, "required": ["slug", "issns", "article_types"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "issns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$"}},
        "article_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
