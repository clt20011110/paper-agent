{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-agent.dev/schemas/stage2-curation-receipt.schema.json",
  "title": "Stage 2 evaluator-private curation import receipt",
  "description": "Private binding from a curation worklist and decisions to strict curated annotations. Do not include in a release bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_hash", "hidden_real_freeze_frame_hash", "worklist_hash", "decisions_hash", "curated_annotations_hash", "source_counts"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_hash": {"$ref": "#/$defs/sha256"},
    "hidden_real_freeze_frame_hash": {"$ref": "#/$defs/sha256"},
    "worklist_hash": {"$ref": "#/$defs/sha256"},
    "decisions_hash": {"$ref": "#/$defs/sha256"},
    "curated_annotations_hash": {"$ref": "#/$defs/sha256"},
    "source_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_provisional", "model_provisional", "human_reviewed_model_suggestion"],
      "properties": {
        "human_provisional": {"type": "integer", "minimum": 0},
        "model_provisional": {"type": "integer", "minimum": 0},
        "human_reviewed_model_suggestion": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
